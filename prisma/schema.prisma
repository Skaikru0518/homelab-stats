// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Device {
  id      String  @id @default(cuid())
  slug    String  @unique
  name    String
  host    String
  enabled Boolean @default(true)

  /// Ha ki van töltve, ez az eszköz a szülő mérésén belül van — nem számít külön az összesítésbe.
  parentId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parent   Device?  @relation("DeviceHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children Device[] @relation("DeviceHierarchy")

  readings Reading[]
  daily    DailyEnergy[]
}

model Reading {
  id            String   @id @default(cuid())
  deviceId      String
  ts            DateTime
  power         Float // W
  voltage       Float // V
  current       Float // A
  apparentPower Float // VA
  reactivePower Float // var
  factor        Float // 0...1
  totalKwh      Float
  device        Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@unique([deviceId, ts])
}

model DailyEnergy {
  id             String   @id @default(cuid())
  deviceId       String
  date           DateTime @db.Date
  kwh            Float
  costHuf        Float // határáron, aznap érvényes árral befagyasztva
  costBlendedHuf Float    @default(0) // számla szerinti átlagáron
  avgPower       Float // W
  peakPower      Float // W
  updatedAt      DateTime @updatedAt

  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@unique([deviceId, date])
}

model ElectricityPrice {
  id               String   @id @default(cuid())
  validFrom        DateTime @unique @db.Date
  /// Határköltség: mennyibe kerül egy plusz kWh a kedvezményes kereten felül.
  hufPerKwh        Float
  /// A számla szerinti tényleges átlagár. Null, ha még nincs elszámoló számla.
  blendedHufPerKwh Float?
  createdAt        DateTime @default(now())
}
